# Скопируйте этот файл в .env (в этой же папке) и вставьте свой ключ.
# .env добавлен в .gitignore и не попадёт в git.
GEMINI_API_KEY=

# Необязательно: какая модель Gemini используется (по умолчанию gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Необязательно: порт сервера (по умолчанию 3000)
# PORT=3000
