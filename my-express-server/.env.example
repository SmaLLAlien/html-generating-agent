# Скопируйте этот файл в .env (в этой же папке) и вставьте свой ключ.
# .env добавлен в .gitignore и не попадёт в git.
GEMINI_API_KEY=

# Необязательно: модель Gemini по умолчанию (gemini-2.5-flash).
# Допустимы только id из реестра src/models.ts: gemini-2.5-flash, gemini-2.5-pro,
# gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview.
# GEMINI_MODEL=gemini-3.6-flash

# Необязательно: рабочий бюджет контекста в токенах (по умолчанию 300000).
# На 80% пользователь получает предупреждение, на 100% диалог блокируется.
# Поставьте небольшое значение, чтобы проверить поведение на пороге.
# CONTEXT_BUDGET_TOKENS=8000

# Необязательно: максимум шагов агентного цикла за один ход (по умолчанию 6)
# MAX_AGENT_STEPS=6

# Необязательно: потолок выходных токенов на шаг (по умолчанию 32000).
# Без него обрыв ответа по длине происходит незаметно.
# MAX_OUTPUT_TOKENS=32000

# Необязательно: защита от исчерпания памяти и разрастания сессий.
# MAX_SESSIONS=500
# MAX_VARIANTS_PER_SESSION=50
# MAX_MESSAGE_LENGTH=8000

# Необязательно: картинки от пользователя. Клиент ужимает их до 1024px по длинной
# стороне, поэтому 4 МБ — запас на случай, если ужатие обошли.
# ATTACHMENT_BODY_LIMIT действует только на маршрут загрузки, остальные остаются на 1 МБ.
# MAX_ATTACHMENT_BYTES=4194304
# MAX_ATTACHMENTS_PER_MESSAGE=4
# MAX_ATTACHMENTS_PER_SESSION=20
# ATTACHMENT_BODY_LIMIT=8mb

# Необязательно: порт сервера (по умолчанию 3000)
# PORT=3000
